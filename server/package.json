{
  "name": "influverse-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "predev": "node ../scripts/security/scan-malware.cjs",
    "prebuild": "node ../scripts/security/scan-malware.cjs",
    "prestart": "node ../scripts/security/scan-malware.cjs",
    "predev:worker": "node ../scripts/security/scan-malware.cjs",
    "prestart:worker": "node ../scripts/security/scan-malware.cjs",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "node -r ts-node/register/transpile-only src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js"
  },
  "author": "Abdur Razzak",
  "license": "ISC",
  "description": "INFLUVERSE backend API (brand-creator marketplace)",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^30.2.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "uuid": "^14.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.66.4",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "5.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.5",
    "rate-limit-redis": "^6.0.2",
    "socket.io": "^4.7.5",
    "stripe": "^16.12.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  }
}
